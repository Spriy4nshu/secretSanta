{
  "name": "secret-santa",
  "version": "1.0.0",
  "private": true,
  "description": "Secret Santa mobile and web application",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @secret-santa/mobile start",
    "web": "yarn workspace @secret-santa/web dev",
    "backend": "yarn workspace @secret-santa/backend dev",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "clean": "yarn workspaces run clean && rm -rf node_modules"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "author": "",
  "license": "MIT"
}
